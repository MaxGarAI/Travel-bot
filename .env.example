# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter API Key (get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Database URL (PostgreSQL)
# For local development with docker-compose:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/travel_bot

# For production (update with your credentials):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/travel_bot

# OpenRouter settings
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free optimal model for travel tasks
OPENROUTER_MODEL=nvidia/nemotron-3-ultra:free

# Optional: Travel API keys (for production use)
# AVIASALES_API_KEY=your_aviasales_key
# AMADEUS_API_KEY=your_amadeus_key
# AMADEUS_API_SECRET=your_amadeus_secret
# BOOKING_COM_API_KEY=your_booking_key

# App settings
DEBUG=false
LOG_LEVEL=INFO